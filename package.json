{
  "name": "dsh-session-delete-pro",
  "version": "1.0.5",
  "type": "module",
  "description": "DeepSeek Harness plugin: delete sessions permanently from the sidebar, through the row menu, the row hover action, or the session_delete agent tool.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "session",
    "delete"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruichina/dsh-session-delete.git"
  },
  "homepage": "https://github.com/ruichina/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/ruichina/dsh-session-delete/issues"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
